# Copie para .env e ajuste se quiser (o docker-compose já tem valores padrão de desenvolvimento).
# NUNCA commite o arquivo .env.

# ---- MariaDB ----
DB_PORT=3306
DB_NAME=chefexpress
DB_USER=chefexpress
DB_PASSWORD=chefexpress
DB_ROOT_PASSWORD=root

# ---- API ----
API_PORT=5094
CORS_ORIGIN=http://localhost:4200

# ---- Geolocalização (OpenStreetMap / Nominatim) ----
# false = não chama o serviço de mapas (perfis ficam sem coordenadas)
GEOCODING_ENABLED=true
# E-mail de contato da equipe, enviado ao Nominatim conforme a política de uso (opcional)
GEOCODING_CONTACT_EMAIL=

# ---- Front-end (futuro) ----
# WEB_PORT=4200
