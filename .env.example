# Copie para .env e ajuste se quiser (o docker-compose já tem valores padrão de desenvolvimento).
# NUNCA commite o arquivo .env.

# ---- MariaDB ----
DB_PORT=3306
DB_NAME=chefexpress
DB_USER=chefexpress
DB_PASSWORD=chefexpress
DB_ROOT_PASSWORD=root

# ---- API ----
API_PORT=5094
CORS_ORIGIN=http://localhost:4200
# Chave que assina os tokens JWT (mínimo 32 caracteres). Em produção, gere uma aleatória:
#   openssl rand -base64 48
JWT_KEY=dev-only-chefexpress-jwt-key-change-me-in-production-0123456789

# ---- Front-end (futuro) ----
# WEB_PORT=4200
